sources:
  bq_lepida_territorio:
    kind: bigquery
    project: ${PROJECT_ID}
    location: US

tools:
  cerca_bandi_regionali:
    kind: bigquery-sql
    source: bq_lepida_territorio
    description: "Restituisce l'elenco dei bandi regionali gestiti da Lepida filtrati per stato (es. APERTO, IN_VALUTAZIONE, CHIUSO o TUTTI)."
    parameters:
      - name: filtro_stato
        type: string
        description: "Stato del bando da cercare: APERTO, IN_VALUTAZIONE, CHIUSO oppure TUTTI per vedere tutti i bandi."
    statement: |
      SELECT
        id_bando,
        titolo,
        ambito,
        budget_totale_eur,
        contributo_massimo_eur,
        quota_cofinanziamento_base_pct,
        stato,
        CAST(data_scadenza AS STRING) AS data_scadenza,
        ente_gestore,
        descrizione
      FROM `lepida_territorio.bandi_regionali`
      WHERE UPPER(@filtro_stato) = 'TUTTI' OR UPPER(stato) = UPPER(@filtro_stato)
      ORDER BY data_scadenza ASC

  verifica_pratiche_ente:
    kind: bigquery-sql
    source: bq_lepida_territorio
    description: "Cerca le pratiche presentate dai Comuni, Unioni o AUSL dell'Emilia-Romagna filtrando per nome dell'Ente (anche parziale, es. 'Bologna', 'Modena', 'Romagna') o codice pratica."
    parameters:
      - name: ricerca_ente_o_pratica
        type: string
        description: "Nome anche parziale dell'Ente richiedente (es. 'Bologna', 'Ferrara', 'Romagna') oppure ID pratica (es. 'PRAT-2026-101')."
    statement: |
      SELECT
        p.id_pratica,
        p.id_bando,
        b.titolo AS titolo_bando,
        p.ente_richiedente,
        p.provincia,
        p.importo_richiesto_eur,
        p.punteggio_tecnico,
        p.stato_pratica,
        CAST(p.data_presentazione AS STRING) AS data_presentazione,
        p.referente_email,
        p.note_istruttore
      FROM `lepida_territorio.pratiche_enti` p
      JOIN `lepida_territorio.bandi_regionali` b
        ON p.id_bando = b.id_bando
      WHERE LOWER(p.ente_richiedente) LIKE CONCAT('%', LOWER(@ricerca_ente_o_pratica), '%')
         OR UPPER(p.id_pratica) = UPPER(@ricerca_ente_o_pratica)
      ORDER BY p.data_presentazione DESC

  riepilogo_pratiche_per_provincia:
    kind: bigquery-sql
    source: bq_lepida_territorio
    description: "Calcola le statistiche aggregate delle pratiche presentate (numero pratiche, budget totale richiesto e punteggio tecnico medio) raggruppate per provincia e stato_pratica."
    statement: |
      SELECT
        provincia,
        stato_pratica,
        COUNT(*) AS numero_pratiche,
        ROUND(SUM(importo_richiesto_eur), 2) AS totale_importo_richiesto_eur,
        ROUND(AVG(punteggio_tecnico), 1) AS punteggio_tecnico_medio
      FROM `lepida_territorio.pratiche_enti`
      GROUP BY provincia, stato_pratica
      ORDER BY totale_importo_richiesto_eur DESC

toolsets:
  lepida_data_toolset:
    - cerca_bandi_regionali
    - verifica_pratiche_ente
    - riepilogo_pratiche_per_provincia
